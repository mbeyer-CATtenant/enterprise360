model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","TMDLView_Desktop"]

ref table Date
ref table Product
ref table Supplier
ref table Facility
ref table 'Purchase Orders'
ref table Shipments
ref table Inventory
ref table 'Supplier Products'

