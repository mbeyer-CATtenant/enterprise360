/// Direct Lake supply-chain model covering purchase-order lines, shipments, inventory snapshots, and supplier-product assignments with conformed Supplier, Customer, Product, Facility, Sales Channel, and Date dimensions sourced from the Enterprise 360 Gold lakehouse.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","TMDLView_Desktop","MCP-PBIModeling"]

ref table Date
ref table Product
ref table Supplier
ref table Facility
ref table 'Purchase Orders'
ref table Shipments
ref table Inventory
ref table 'Supplier Products'
ref table Customer
ref table 'Sales Channel'

