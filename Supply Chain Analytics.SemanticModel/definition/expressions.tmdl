expression OneLakeWorkspaceId = "e809baaa-4226-4e06-93a2-26cfb3476f49" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

expression OneLakeLakehouseId = "45e498e1-6aaf-42e0-b0a1-926b4c34cf22" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

expression DirectLakeSource =
		let
			Source = AzureStorage.DataLake(
				"https://onelake.dfs.fabric.microsoft.com/" & OneLakeWorkspaceId & "/" & OneLakeLakehouseId,
				[HierarchicalNavigation=true]
			)
		in
			Source
