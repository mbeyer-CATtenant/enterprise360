relationship 'Purchase Orders to Date'
	fromColumn: 'Purchase Orders'.'Order Date'
	toColumn: Date.Date

relationship 'Purchase Orders to Supplier'
	fromColumn: 'Purchase Orders'.'Supplier Key'
	toColumn: Supplier.'Supplier Key'

relationship 'Purchase Orders to Product'
	fromColumn: 'Purchase Orders'.'Product Key'
	toColumn: Product.'Product Key'

relationship 'Purchase Orders to Facility'
	fromColumn: 'Purchase Orders'.'Facility Key'
	toColumn: Facility.'Facility Key'

relationship 'Shipments to Date'
	fromColumn: Shipments.'Ship Date'
	toColumn: Date.Date

relationship 'Shipments to Facility'
	fromColumn: Shipments.'Facility Key'
	toColumn: Facility.'Facility Key'

relationship 'Inventory to Date'
	fromColumn: Inventory.'Snapshot Date'
	toColumn: Date.Date

relationship 'Inventory to Product'
	fromColumn: Inventory.'Product Key'
	toColumn: Product.'Product Key'

relationship 'Inventory to Facility'
	fromColumn: Inventory.'Facility Key'
	toColumn: Facility.'Facility Key'

relationship 'Supplier Products to Supplier'
	fromColumn: 'Supplier Products'.'Supplier Key'
	toColumn: Supplier.'Supplier Key'

relationship 'Supplier Products to Product'
	fromColumn: 'Supplier Products'.'Product Key'
	toColumn: Product.'Product Key'

