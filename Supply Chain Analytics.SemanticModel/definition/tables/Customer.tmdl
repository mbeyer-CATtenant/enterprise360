/// Organizations receiving shipments from the enterprise.
table Customer
	lineageTag: 7ed9c7cc-e4aa-4d8d-9931-775a2c0f8a2e

	/// Number of customers currently marked active.
	measure '# Active Customers' = CALCULATE(COUNTROWS(Customer), KEEPFILTERS(Customer[Customer Status] = "Active"))
		formatString: #,##0
		displayFolder: Measures\Counts
		lineageTag: 9a94c7e3-c8d4-4c36-8d7f-8cdecc607771

	/// Number of customer records by their creation date.
	measure '# Customers Created' =
			CALCULATE(
			    COUNTROWS(Customer),
			    USERELATIONSHIP(Customer[Created On Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: 1618662a-96ef-4790-89ab-5b6862060747

	/// Number of customer records by their most recent modification date.
	measure '# Customers Modified' =
			CALCULATE(
			    COUNTROWS(Customer),
			    USERELATIONSHIP(Customer[Modified On Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: 2fb784da-1022-4d43-a272-bd2c27b87435

	/// Integer customer relationship key.
	column 'Customer Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: c5632388-106b-4752-9c60-8aa7f4b1b32e
		summarizeBy: none
		sourceColumn: customer_key

	/// Stable customer identifier.
	column 'Customer ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: c8b7c677-47ed-43fb-9937-52bdf47dd7b6
		summarizeBy: none
		sourceColumn: customer_id

	/// Customer organization name.
	column 'Customer Name'
		dataType: string
		lineageTag: 30a8ca0c-d084-498c-8247-047c88ced86a
		summarizeBy: none
		sourceColumn: customer_name

	/// Commercial segment assigned to the customer.
	column 'Customer Segment'
		dataType: string
		lineageTag: 4290dbe8-62da-4ae9-8a86-66a958631ba4
		summarizeBy: none
		sourceColumn: customer_segment

	/// Primary industry in which the customer operates.
	column Industry
		dataType: string
		lineageTag: 79d242f2-583c-42f5-baea-1fd7daa05202
		summarizeBy: none
		sourceColumn: industry

	/// Enterprise operating region assigned to the customer.
	column Region
		dataType: string
		lineageTag: 89fcaae4-46c2-46ff-842d-3052dc621c88
		summarizeBy: none
		sourceColumn: region_code

	/// Two-letter customer country code.
	column Country
		dataType: string
		lineageTag: 7b7e47e2-287d-41f5-b313-94fc29ccbf07
		dataCategory: Country
		summarizeBy: none
		sourceColumn: country_code

	/// Customer city used for geographic analysis.
	column City
		dataType: string
		lineageTag: 2e265b61-d327-402d-b6dc-fb7e521b24b1
		dataCategory: City
		summarizeBy: none
		sourceColumn: city

	/// Annual revenue used to classify account size.
	column 'Annual Revenue'
		dataType: decimal
		formatString: $#,##0.00
		lineageTag: 741e7a8f-0c8c-4a62-a51b-c051f5100898
		summarizeBy: none
		sourceColumn: annual_revenue

	/// Current commercial risk classification.
	column 'Risk Tier'
		dataType: string
		lineageTag: cf5cbb58-f697-4444-b077-d8b17703c48c
		summarizeBy: none
		sourceColumn: risk_tier

	/// Current customer lifecycle status.
	column 'Customer Status'
		dataType: string
		lineageTag: 3f753ac0-5d57-4324-a0a1-a39503565c92
		summarizeBy: none
		sourceColumn: status

	/// Date on which the customer record was created.
	column 'Created On'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 843f2604-ec2a-49a2-a30c-e2385ad4f27b
		summarizeBy: none
		sourceColumn: created_on

	/// Integer date key for customer creation-date analysis.
	column 'Created On Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 2ad6ff57-91f1-4132-95b7-6ba5ded9862d
		summarizeBy: none
		sourceColumn: created_on_key

	/// Date on which the customer record was last modified.
	column 'Modified On'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 5856a501-d389-42eb-9be8-fe25523a4ead
		summarizeBy: none
		sourceColumn: modified_on

	/// Integer date key for customer modification-date analysis.
	column 'Modified On Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: ee230181-05fc-4a92-b1e0-1769431eff8d
		summarizeBy: none
		sourceColumn: modified_on_key

	partition Customer = entity
		mode: directLake
		source
			entityName: dim_customer
			schemaName: gold
			expressionSource: DirectLakeSource

