/// Procurement detail at one row per purchase-order line.
table 'Purchase Orders'
	lineageTag: 9f461146-5aad-401e-8fb2-c91eb4bb1b9a

	/// Extended procurement value based on ordered quantity and unit cost.
	measure 'Purchased Value' = SUM('Purchase Orders'[Purchased Value Source])
		formatString: $#,##0.00
		displayFolder: Measures\Value
		lineageTag: e6fc4ff6-adff-4873-80fd-d1bd25d99086

	/// Number of distinct purchase orders.
	measure '# Purchase Orders' = DISTINCTCOUNT('Purchase Orders'[Purchase Order ID])
		formatString: #,##0
		displayFolder: Measures\Counts
		lineageTag: 3ae5cdcd-7c97-4813-a288-975e8e7556f4

	/// Total quantity ordered from suppliers.
	measure 'Total Ordered Quantity' = SUM('Purchase Orders'[Ordered Quantity])
		formatString: #,##0
		displayFolder: Measures\Quantity
		lineageTag: 517ed9b3-0854-4332-bcdb-a214b9b825ca

	/// Total quantity received from suppliers.
	measure 'Total Received Quantity' = SUM('Purchase Orders'[Received Quantity])
		formatString: #,##0
		displayFolder: Measures\Quantity
		lineageTag: e410ab87-e218-423d-b5fd-faf5bdbbaf6d

	/// Received quantity divided by ordered quantity.
	measure 'Supplier Fill Rate' = DIVIDE([Total Received Quantity], [Total Ordered Quantity])
		formatString: 0.00%
		displayFolder: Measures\Rates
		lineageTag: dc0fcc2f-6f5d-48d1-97ad-5f13e41453b2

	/// Percentage of received lines arriving on or before the expected date.
	measure 'On-Time Receipt Rate' =
			VAR _receivedLines =
				CALCULATE(
					COUNTROWS('Purchase Orders'),
					KEEPFILTERS('Purchase Orders'[Purchase Order Status] <> "Open")
				)
			VAR _onTimeLines =
				CALCULATE(
					COUNTROWS('Purchase Orders'),
					KEEPFILTERS('Purchase Orders'[Purchase Order Status] <> "Open"),
					KEEPFILTERS('Purchase Orders'[Received Date] <= 'Purchase Orders'[Expected Date])
				)
			RETURN
				DIVIDE(_onTimeLines, _receivedLines)
		formatString: 0.00%
		displayFolder: Measures\Rates
		lineageTag: ee88ca78-7d4e-4102-b7c4-2428aa82dcc7

	/// Number of distinct purchase orders by their expected receipt date.
	measure '# Purchase Orders by Expected Date' =
			CALCULATE(
			    [# Purchase Orders],
			    USERELATIONSHIP('Purchase Orders'[Expected Date Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: e9570436-10bf-4114-af64-e34030bfe417

	/// Number of distinct purchase orders by their actual receipt date.
	measure '# Purchase Orders by Received Date' =
			CALCULATE(
			    [# Purchase Orders],
			    USERELATIONSHIP('Purchase Orders'[Received Date Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: a27ce0b4-42a6-40ae-8879-4b83ca93de54

	/// Stable purchase-order-line identifier.
	column 'Purchase Order Line ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 3dbf93e3-82ae-404b-8811-4ec5e5ecf6b8
		summarizeBy: none
		sourceColumn: purchase_order_line_id

	/// Purchase-order header identifier used for distinct-order counts.
	column 'Purchase Order ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 5186b3d2-33a0-456b-92a1-2c37e17734b2
		summarizeBy: none
		sourceColumn: purchase_order_id

	/// Integer supplier relationship key.
	column 'Supplier Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: de77b7f4-cd54-47d1-8573-721cc74bb2a7
		summarizeBy: none
		sourceColumn: supplier_key

	/// Supplier relationship key.
	column 'Supplier ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: ac52a87a-1c61-4c75-a5db-b1ccf2f30d5b
		summarizeBy: none
		sourceColumn: supplier_id

	/// Integer product relationship key.
	column 'Product Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 86853c8b-49ca-44d8-b528-4bbef4186ba3
		summarizeBy: none
		sourceColumn: product_key

	/// Product relationship key.
	column 'Product ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 3ed3cb27-3089-4257-8188-f6ac5b7c4e1a
		summarizeBy: none
		sourceColumn: product_id

	/// Integer facility relationship key.
	column 'Facility Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 44303133-6d72-47a5-a762-b44a77b7e66c
		summarizeBy: none
		sourceColumn: facility_key

	/// Facility relationship key.
	column 'Facility ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 65933fd9-01d2-4d96-ae93-866cbb9cffae
		summarizeBy: none
		sourceColumn: facility_id

	/// Date on which the purchase order was placed.
	column 'Order Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 2f075124-0ec3-4cc7-beab-5fd918d05815
		summarizeBy: none
		sourceColumn: order_date

	/// Date on which the supplier was expected to deliver.
	column 'Expected Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 37729a8f-5f62-48dc-b032-faba0a71e43c
		summarizeBy: none
		sourceColumn: expected_date

	/// Date on which the line was actually received.
	column 'Received Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 1da4fa61-f97d-4ae7-8616-6a72e1bfd811
		summarizeBy: none
		sourceColumn: received_date

	/// Quantity requested from the supplier.
	column 'Ordered Quantity'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 0a534203-34e1-43c3-b02e-5d1e00a9412b
		summarizeBy: none
		sourceColumn: ordered_quantity

	/// Quantity received from the supplier.
	column 'Received Quantity'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: e9482540-f852-458d-8597-022dd70392d3
		summarizeBy: none
		sourceColumn: received_quantity

	/// Contracted unit cost for the purchase-order line.
	column 'Unit Cost'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		lineageTag: dca3f668-bdaa-4421-9885-a071466a402b
		summarizeBy: none
		sourceColumn: unit_cost

	/// Current receiving status of the line.
	column 'Purchase Order Status'
		dataType: string
		lineageTag: 3a0dcff1-d958-4225-9c02-31734f0166d7
		summarizeBy: none
		sourceColumn: purchase_order_status

	/// Integer date key for the purchase-order date relationship.
	column 'Order Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 33b5488e-7bc3-4bd4-a301-f43bf77e0767
		summarizeBy: none
		sourceColumn: order_date_key

	/// Integer date key for expected receipt-date analysis.
	column 'Expected Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 4f01157d-ec57-4db9-83ef-a1011b7becb3
		summarizeBy: none
		sourceColumn: expected_date_key

	/// Integer date key for actual receipt-date analysis.
	column 'Received Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 08735a9a-9f7e-437b-9bdc-e19195016a2f
		summarizeBy: none
		sourceColumn: received_date_key

	/// Materialized purchase-order-line value used by the Purchased Value measure.
	column 'Purchased Value Source'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		lineageTag: 6e9dc1de-e96b-413b-977c-f8a545ca9db8
		summarizeBy: none
		sourceColumn: purchased_value

	partition 'Purchase Orders' = entity
		mode: directLake
		source
			entityName: fact_purchase_order_line
			schemaName: gold
			expressionSource: DirectLakeSource

