/// Plants, distribution centers, and service hubs operated by the enterprise.
table Facility
	lineageTag: b1bdc21c-ac74-44cb-86fb-0a601dce8ad7

	/// Number of facility records by their creation date.
	measure '# Facilities Created' =
			CALCULATE(
			    COUNTROWS(Facility),
			    USERELATIONSHIP(Facility[Created On Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: c5d930f9-5031-4d41-9ca3-4de691172e2d

	/// Number of facility records by their most recent modification date.
	measure '# Facilities Modified' =
			CALCULATE(
			    COUNTROWS(Facility),
			    USERELATIONSHIP(Facility[Modified On Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: 474a049b-93b6-4de8-9f07-b1b7481cfb5e

	/// Integer relationship key optimized for Direct Lake joins.
	column 'Facility Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 0ae0cae5-0e7d-480d-bc0c-f4625edc8121
		summarizeBy: none
		sourceColumn: facility_key

	/// Stable facility identifier used by operational relationships.
	column 'Facility ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 895984b8-004a-4ed9-93e0-5bdbd87d7893
		summarizeBy: none
		sourceColumn: facility_id

	/// Business-facing facility name.
	column 'Facility Name'
		dataType: string
		lineageTag: c138a0b8-288d-409b-9395-0502e9f4207a
		summarizeBy: none
		sourceColumn: facility_name

	/// Operational purpose of the facility.
	column 'Facility Type'
		dataType: string
		lineageTag: a5f88ad6-3497-45ab-8b4e-6be2eaa2fc94
		summarizeBy: none
		sourceColumn: facility_type

	/// Enterprise operating region assigned to the facility.
	column Region
		dataType: string
		lineageTag: ca735694-388a-45b3-9981-f160e5cfdee8
		summarizeBy: none
		sourceColumn: region_code

	/// Two-letter facility country code.
	column Country
		dataType: string
		lineageTag: 2344b264-e925-4505-bbad-f34133795381
		dataCategory: Country
		summarizeBy: none
		sourceColumn: country_code

	/// Facility city used for geographic analysis.
	column City
		dataType: string
		lineageTag: e7b60d8d-20a8-45fa-84c5-8523506c8331
		dataCategory: City
		summarizeBy: none
		sourceColumn: city

	/// Synthetic operating capacity of the facility.
	column 'Capacity Units'
		dataType: int64
		formatString: #,##0
		lineageTag: 81605587-41cd-4812-b3e5-2219709d0d7d
		summarizeBy: none
		sourceColumn: capacity_units

	/// Current facility lifecycle status.
	column Status
		dataType: string
		lineageTag: abb1565c-438f-4274-a7d1-b3b6cbb2d1a3
		summarizeBy: none
		sourceColumn: status

	/// Date on which the facility record was created.
	column 'Created On'
		dataType: dateTime
		formatString: Short Date
		lineageTag: aec7d77f-2c58-4b1d-a6ad-7c2473ed38ab
		summarizeBy: none
		sourceColumn: created_on

	/// Integer date key for facility creation-date analysis.
	column 'Created On Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: aec11f9f-5cb9-4e3d-b310-f6e477b35901
		summarizeBy: none
		sourceColumn: created_on_key

	/// Date on which the facility record was last modified.
	column 'Modified On'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 15aae12a-032d-4720-9760-6269d7cd11eb
		summarizeBy: none
		sourceColumn: modified_on

	/// Integer date key for facility modification-date analysis.
	column 'Modified On Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 407fcf86-3617-4702-9714-8800c7d2405a
		summarizeBy: none
		sourceColumn: modified_on_key

	partition Facility = entity
		mode: directLake
		source
			entityName: dim_facility
			schemaName: gold
			expressionSource: DirectLakeSource

