/// Products, equipment, vehicles, controls, sensors, and replacement parts sold by the enterprise.
table Product
	lineageTag: c60f63ed-9d4e-42c0-94e6-20633db676fc

	/// Number of product records by their creation date.
	measure '# Products Created' =
			CALCULATE(
			    COUNTROWS(Product),
			    USERELATIONSHIP(Product[Created On Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: acb2ea16-fa0d-4a6a-8fda-f1b9d8d9ea21

	/// Number of product records by their most recent modification date.
	measure '# Products Modified' =
			CALCULATE(
			    COUNTROWS(Product),
			    USERELATIONSHIP(Product[Modified On Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: 006bc5da-b3e2-412b-b072-98d3e4a9e944

	/// Integer relationship key optimized for Direct Lake joins.
	column 'Product Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: c57452f5-9065-4bb5-a092-3967f8eb8dda
		summarizeBy: none
		sourceColumn: product_key

	/// Stable product identifier used by model relationships.
	column 'Product ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 9c7ecad9-feaa-4a48-b5a1-ba11c3f6688e
		summarizeBy: none
		sourceColumn: product_id

	/// Stock keeping unit used in commercial processes.
	column SKU
		dataType: string
		lineageTag: 43d2e368-450a-4a49-8cca-b59e3402b225
		summarizeBy: none
		sourceColumn: sku

	/// Business-facing product name.
	column 'Product Name'
		dataType: string
		lineageTag: 2a04bf68-5f1a-4509-8c48-43548c323e65
		summarizeBy: none
		sourceColumn: product_name

	/// High-level product classification.
	column 'Product Category'
		dataType: string
		lineageTag: 7b0906c6-9ad1-4f16-8932-58f4bd349cd5
		summarizeBy: none
		sourceColumn: product_category

	/// Product family used for portfolio analysis.
	column 'Product Family'
		dataType: string
		lineageTag: 58cd9742-7bab-4859-86dc-ddcf74b677b2
		summarizeBy: none
		sourceColumn: product_family

	/// Standard cost used for margin calculations.
	column 'Standard Cost'
		dataType: decimal
		formatString: $#,##0.00
		lineageTag: b4423e41-6bef-4d7f-acfe-3612005806d0
		summarizeBy: none
		sourceColumn: standard_cost

	/// Published selling price before discounts.
	column 'List Price'
		dataType: decimal
		formatString: $#,##0.00
		lineageTag: ca039f4d-1ef9-4cac-9aa5-e72e4381061d
		summarizeBy: none
		sourceColumn: list_price

	/// Expected replenishment lead time.
	column 'Lead Time Days'
		dataType: int64
		formatString: 0
		lineageTag: 95379bd7-a1f3-475d-b614-23096a9648cc
		summarizeBy: none
		sourceColumn: lead_time_days

	/// Shipping weight in kilograms.
	column 'Weight Kilograms'
		dataType: decimal
		formatString: #,##0.00
		lineageTag: c25a87b5-3fc9-4acd-84ed-dcba7843b7ec
		summarizeBy: none
		sourceColumn: weight_kg

	/// Identifies parts that are operationally critical.
	column 'Critical Spare'
		dataType: boolean
		lineageTag: fae0c82b-41b7-4cb8-a678-11c7993db6e6
		summarizeBy: none
		sourceColumn: critical_spare

	/// Current product lifecycle status.
	column Status
		dataType: string
		lineageTag: 5a2f8689-83e4-47f1-9055-4e4fec326632
		summarizeBy: none
		sourceColumn: status

	/// Date on which the product record was created.
	column 'Created On'
		dataType: dateTime
		formatString: Short Date
		lineageTag: ecfdfe62-6323-4af9-83d0-c6c418a015bf
		summarizeBy: none
		sourceColumn: created_on

	/// Integer date key for product creation-date analysis.
	column 'Created On Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: f36b2388-58cb-410c-bdd2-88a93d9040a2
		summarizeBy: none
		sourceColumn: created_on_key

	/// Date on which the product record was last modified.
	column 'Modified On'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 0b34a5a1-d504-4c1a-b668-6fb90174bcc5
		summarizeBy: none
		sourceColumn: modified_on

	/// Integer date key for product modification-date analysis.
	column 'Modified On Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 1c7aeae9-55de-4c34-90d8-0028811c4c7a
		summarizeBy: none
		sourceColumn: modified_on_key

	partition Product = entity
		mode: directLake
		source
			entityName: dim_product
			schemaName: gold
			expressionSource: DirectLakeSource

