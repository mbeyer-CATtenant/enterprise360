/// Outbound shipment events supporting order fulfillment analysis.
table Shipments
	lineageTag: dff926f8-5611-4251-b13b-b80736cc48ed

	/// Number of shipment records.
	measure '# Shipments' = COUNTROWS(Shipments)
		formatString: #,##0
		displayFolder: Measures\Counts
		lineageTag: 970f8377-c5db-419d-abf2-bac07f5ed604

	/// Number of shipments marked delivered.
	measure '# Delivered Shipments' = CALCULATE(COUNTROWS(Shipments), KEEPFILTERS(Shipments[Shipment Status] = "Delivered"))
		formatString: #,##0
		displayFolder: Measures\Counts
		lineageTag: e1241198-4142-49de-996e-702f072c6122

	/// Percentage of delivered shipments arriving by the promised date.
	measure 'On-Time Delivery Rate' =
			VAR _deliveredShipments = [# Delivered Shipments]
			VAR _onTimeShipments =
				CALCULATE(
					COUNTROWS(Shipments),
					KEEPFILTERS(Shipments[Shipment Status] = "Delivered"),
					KEEPFILTERS(Shipments[Actual Delivery Date] <= Shipments[Promised Delivery Date])
				)
			RETURN
				DIVIDE(_onTimeShipments, _deliveredShipments)
		formatString: 0.00%
		displayFolder: Measures\Rates
		lineageTag: ce9cac62-480b-4e76-b475-02644b9a37cb

	/// Total outbound freight expense.
	measure 'Freight Cost' = SUM(Shipments[Freight Cost Value])
		formatString: $#,##0.00
		displayFolder: Measures\Value
		lineageTag: 1406029b-aa13-4640-9fd4-e75ef058b8e7

	/// Percentage of shipments currently or previously marked for quality hold.
	measure 'Quality Hold Rate' =
			VAR _qualityHolds =
				CALCULATE(
					COUNTROWS(Shipments),
					KEEPFILTERS(Shipments[Quality Hold] = TRUE())
				)
			RETURN
				DIVIDE(_qualityHolds, [# Shipments])
		formatString: 0.00%
		displayFolder: Measures\Rates
		lineageTag: 18084961-008f-4580-b87d-ffb4f78758f4

	/// Number of shipments by their promised delivery date.
	measure '# Shipments by Promised Delivery Date' =
			CALCULATE(
			    [# Shipments],
			    USERELATIONSHIP(Shipments[Promised Delivery Date Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: f19c7675-fe8d-4c54-bf5d-2d6e7e424b2b

	/// Number of shipments by their actual delivery date.
	measure '# Shipments by Actual Delivery Date' =
			CALCULATE(
			    [# Shipments],
			    USERELATIONSHIP(Shipments[Actual Delivery Date Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: 4c7eec28-78e4-4d44-b058-d7a74e35da35

	/// Number of shipments analyzed by the associated customer order date.
	measure '# Shipments by Order Date' =
			CALCULATE(
			    [# Shipments],
			    USERELATIONSHIP(Shipments[Order Date Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: 780b3031-5d27-4559-956a-1d2928caed17

	/// Number of shipments analyzed by the requested fulfillment date.
	measure '# Shipments by Requested Date' =
			CALCULATE(
			    [# Shipments],
			    USERELATIONSHIP(Shipments[Requested Date Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: 959a8a7a-b502-47b5-b3e8-795c1befc76f

	/// Stable shipment identifier.
	column 'Shipment ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 40a5a8e1-2226-4dfa-9fce-2ea29836add1
		summarizeBy: none
		sourceColumn: shipment_id

	/// Sales-order identifier associated with the shipment.
	column 'Sales Order ID'
		dataType: string
		lineageTag: 731ccd38-c1eb-4c27-a69a-ec971d5db351
		summarizeBy: none
		sourceColumn: sales_order_id

	/// Integer facility relationship key.
	column 'Facility Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: e10d2504-be7e-4ff1-b0ae-46855535f1ef
		summarizeBy: none
		sourceColumn: facility_key

	/// Facility relationship key.
	column 'Facility ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: a8eb26ab-3919-4147-81f2-2bebf2ff989b
		summarizeBy: none
		sourceColumn: facility_id

	/// Logistics provider responsible for the shipment.
	column Carrier
		dataType: string
		lineageTag: 626027ac-bbe6-45c6-a744-7c245f1569b6
		summarizeBy: none
		sourceColumn: carrier_name

	/// Date on which the shipment departed.
	column 'Ship Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 3011320e-5ab0-4cbf-88dc-534a3e2a9160
		summarizeBy: none
		sourceColumn: ship_date

	/// Customer promise date for delivery.
	column 'Promised Delivery Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 45a2921b-d09c-4c27-89b8-1dd5b0530a4b
		summarizeBy: none
		sourceColumn: promised_delivery_date

	/// Actual delivery date when available.
	column 'Actual Delivery Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 143afa1e-65d8-466a-b1c0-2f052b8306d5
		summarizeBy: none
		sourceColumn: actual_delivery_date

	/// Freight expense recorded for the shipment.
	column 'Freight Cost Value'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		lineageTag: 473f003a-006d-4bbc-999c-005e72906484
		summarizeBy: none
		sourceColumn: freight_cost

	/// Identifies shipments blocked for quality review.
	column 'Quality Hold'
		dataType: boolean
		lineageTag: cc013b84-2bfe-4994-9716-ad3e03d7e6b9
		summarizeBy: none
		sourceColumn: quality_hold

	/// Current logistics status.
	column 'Shipment Status'
		dataType: string
		lineageTag: bb5fade1-c82f-4646-96ae-9bbd5f6c204f
		summarizeBy: none
		sourceColumn: shipment_status

	/// Integer date key for the shipment-date relationship.
	column 'Ship Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: fe19a152-beb3-40e2-b1c4-a7b53e54edd1
		summarizeBy: none
		sourceColumn: ship_date_key

	/// Integer date key for promised delivery-date analysis.
	column 'Promised Delivery Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 1e87992a-1949-4626-9fd2-90f5b764cec8
		summarizeBy: none
		sourceColumn: promised_delivery_date_key

	/// Integer date key for actual delivery-date analysis.
	column 'Actual Delivery Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: f822ee80-7477-4e06-b057-b9c6174f0152
		summarizeBy: none
		sourceColumn: actual_delivery_date_key

	/// Integer customer key for direct shipment analysis.
	column 'Customer Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: f02454ca-268e-4936-bf39-06d15ad99ab1
		summarizeBy: none
		sourceColumn: customer_key

	/// Integer sales-channel key for direct shipment analysis.
	column 'Sales Channel Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 06c2e79c-a2ab-4550-91ca-8cd49e9535fa
		summarizeBy: none
		sourceColumn: sales_channel_key

	/// Integer key for the order date associated with the shipment.
	column 'Order Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: abcd7fbe-93b3-4b66-ba97-7726c5ae16c6
		summarizeBy: none
		sourceColumn: order_date_key

	/// Integer key for the requested fulfillment date associated with the shipment.
	column 'Requested Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 53ae1e8c-60af-41b3-af12-aa1f848b9b2c
		summarizeBy: none
		sourceColumn: requested_date_key

	partition Shipments = entity
		mode: directLake
		source
			entityName: fact_shipment
			schemaName: gold
			expressionSource: DirectLakeSource

