/// Direct Lake commercial analytics model covering sales-order headers and sales-line facts, with conformed Customer, Product, Sales Channel, and Date dimensions sourced from the Enterprise 360 Gold lakehouse.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","TMDLView_Desktop","MCP-PBIModeling"]

ref table Date
ref table Customer
ref table Product
ref table 'Sales Channel'
ref table Orders
ref table Sales

