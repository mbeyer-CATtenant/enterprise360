relationship 'Orders to Customer'
	fromColumn: Orders.'Customer Key'
	toColumn: Customer.'Customer Key'

relationship 'Orders to Sales Channel'
	fromColumn: Orders.'Sales Channel Key'
	toColumn: 'Sales Channel'.'Sales Channel Key'

relationship 'Sales to Product'
	fromColumn: Sales.'Product Key'
	toColumn: Product.'Product Key'

relationship 'Orders to Date'
	fromColumn: Orders.'Order Date Key'
	toColumn: Date.'Date Key'

relationship 'Orders Requested Date to Date'
	isActive: false
	fromColumn: Orders.'Requested Date Key'
	toColumn: Date.'Date Key'

relationship 'Sales to Customer'
	fromColumn: Sales.'Customer Key'
	toColumn: Customer.'Customer Key'

