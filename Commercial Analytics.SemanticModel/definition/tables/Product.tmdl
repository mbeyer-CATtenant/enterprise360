/// Products, equipment, vehicles, controls, sensors, and replacement parts sold by the enterprise.
table Product
	lineageTag: f2fff72b-e8ce-4f12-ac86-068776e767f4

	/// Number of product records by their creation date.
	measure '# Products Created' =
			CALCULATE(
			    COUNTROWS(Product),
			    USERELATIONSHIP(Product[Created On Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: 63f1822f-ae8e-48c8-8987-e2001c27c035

	/// Number of product records by their most recent modification date.
	measure '# Products Modified' =
			CALCULATE(
			    COUNTROWS(Product),
			    USERELATIONSHIP(Product[Modified On Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: 92ddab54-ffe8-46a0-ac9f-d08b91635edd

	/// Integer relationship key optimized for Direct Lake joins.
	column 'Product Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: db0bd776-dd9b-492c-8279-17bf22197fce
		summarizeBy: none
		sourceColumn: product_key

	/// Stable product identifier used by model relationships.
	column 'Product ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 4e4d1d5c-5641-4456-a5c1-908fe0aaa52f
		summarizeBy: none
		sourceColumn: product_id

	/// Stock keeping unit used in commercial processes.
	column SKU
		dataType: string
		lineageTag: c31dd1d7-8b20-422b-9522-011f0eeb1c1b
		summarizeBy: none
		sourceColumn: sku

	/// Business-facing product name.
	column 'Product Name'
		dataType: string
		lineageTag: d435eced-39ed-4dcf-bb4d-b7db792d12c5
		summarizeBy: none
		sourceColumn: product_name

	/// High-level product classification.
	column 'Product Category'
		dataType: string
		lineageTag: b6d0c900-8f3a-4699-ac9c-58965becabc0
		summarizeBy: none
		sourceColumn: product_category

	/// Product family used for portfolio analysis.
	column 'Product Family'
		dataType: string
		lineageTag: 20bfaaca-42a4-4cdb-9467-7c0921044572
		summarizeBy: none
		sourceColumn: product_family

	/// Standard cost used for margin calculations.
	column 'Standard Cost'
		dataType: decimal
		formatString: $#,##0.00
		lineageTag: 2f778125-61e2-4dc8-afe3-b36db5999f0b
		summarizeBy: none
		sourceColumn: standard_cost

	/// Published selling price before discounts.
	column 'List Price'
		dataType: decimal
		formatString: $#,##0.00
		lineageTag: 4f74e2d7-7029-41eb-a711-c8ed2fe92e03
		summarizeBy: none
		sourceColumn: list_price

	/// Expected replenishment lead time.
	column 'Lead Time Days'
		dataType: int64
		formatString: 0
		lineageTag: 63290c0b-a3a4-49a6-8c51-f6e2ea63d940
		summarizeBy: none
		sourceColumn: lead_time_days

	/// Shipping weight in kilograms.
	column 'Weight Kilograms'
		dataType: decimal
		formatString: #,##0.00
		lineageTag: 4472c04a-8df3-4be2-af88-c63556a83283
		summarizeBy: none
		sourceColumn: weight_kg

	/// Identifies parts that are operationally critical.
	column 'Critical Spare'
		dataType: boolean
		lineageTag: ee5d1347-f2ed-4e0a-99d1-b3fd1d117672
		summarizeBy: none
		sourceColumn: critical_spare

	/// Current product lifecycle status.
	column 'Product Status'
		dataType: string
		lineageTag: 6961562b-5a6f-4603-918f-08a43949b6cf
		summarizeBy: none
		sourceColumn: status

		changedProperty = Name

	/// Date on which the product record was created.
	column 'Created On'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 91e40139-19c9-43bc-9183-60f93ce3f97d
		summarizeBy: none
		sourceColumn: created_on

	/// Integer date key for product creation-date analysis.
	column 'Created On Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 8ccab90b-91bf-4f67-864d-612338f81410
		summarizeBy: none
		sourceColumn: created_on_key

	/// Date on which the product record was last modified.
	column 'Modified On'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 43a14616-d245-48ec-9e7a-87777158b1f6
		summarizeBy: none
		sourceColumn: modified_on

	/// Integer date key for product modification-date analysis.
	column 'Modified On Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: ad5a7356-29ff-4c09-ab72-1b3125076228
		summarizeBy: none
		sourceColumn: modified_on_key

	partition Product = entity
		mode: directLake
		source
			entityName: dim_product
			schemaName: gold
			expressionSource: DirectLakeSource

