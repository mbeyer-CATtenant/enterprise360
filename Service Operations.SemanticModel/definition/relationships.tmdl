relationship 'Technician to Employee'
	fromColumn: Technician.'Employee Key'
	toColumn: Employee.'Employee Key'

relationship 'Asset to Customer'
	fromColumn: Asset.'Customer Key'
	toColumn: Customer.'Customer Key'

relationship 'Asset to Product'
	fromColumn: Asset.'Product Key'
	toColumn: Product.'Product Key'

relationship 'Asset to Facility'
	fromColumn: Asset.'Facility Key'
	toColumn: Facility.'Facility Key'

relationship 'Work Orders to Date'
	fromColumn: 'Work Orders'.'Opened Date'
	toColumn: Date.Date

relationship 'Work Orders to Asset'
	fromColumn: 'Work Orders'.'Asset Key'
	toColumn: Asset.'Asset Key'

relationship 'Work Orders to Technician'
	fromColumn: 'Work Orders'.'Technician Key'
	toColumn: Technician.'Technician Key'

relationship 'Work Order Parts to Work Orders'
	fromColumn: 'Work Order Parts'.'Work Order Key'
	toColumn: 'Work Orders'.'Work Order Key'

relationship 'Work Order Parts to Part Product'
	fromColumn: 'Work Order Parts'.'Product Key'
	toColumn: 'Part Product'.'Product Key'

relationship 'Asset Daily Status to Date'
	fromColumn: 'Asset Daily Status'.'Status Date'
	toColumn: Date.Date

relationship 'Asset Daily Status to Asset'
	fromColumn: 'Asset Daily Status'.'Asset Key'
	toColumn: Asset.'Asset Key'

