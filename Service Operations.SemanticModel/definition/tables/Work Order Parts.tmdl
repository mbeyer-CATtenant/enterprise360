/// Replacement parts consumed by service work orders.
table 'Work Order Parts'
	lineageTag: 20dcdf8c-26f7-45bf-bf50-505d3f3ba676

	/// Extended standard cost of parts consumed by service work.
	measure 'Parts Cost' = SUM('Work Order Parts'[Part Cost Value])
		formatString: $#,##0.00
		displayFolder: Measures\Value
		lineageTag: 2eff9bbd-49e0-4dde-8e12-c7f0265c260c

	/// Number of replacement-part units consumed.
	measure 'Parts Used' = SUM('Work Order Parts'[Quantity Used])
		formatString: #,##0
		displayFolder: Measures\Quantity
		lineageTag: 506a1405-9b92-4fe1-8f95-744ce891d099

	/// Number of work-order part lines.
	measure '# Work Order Part Lines' = COUNTROWS('Work Order Parts')
		formatString: #,##0
		displayFolder: Measures\Counts
		lineageTag: 96820d13-3c05-488b-8852-972f126693db

	/// Number of work-order part lines analyzed by the associated work order resolution date.
	measure '# Work Order Part Lines by Resolved Date' =
			CALCULATE(
			    [# Work Order Part Lines],
			    USERELATIONSHIP('Work Order Parts'[Resolved Date Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: f3e370a9-11b7-4ec4-a015-a2ad43397d46

	/// Stable work-order-part identifier.
	column 'Work Order Part ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 33af8002-da5e-45fa-b136-616a13decd3a
		summarizeBy: none
		sourceColumn: work_order_part_id

	/// Integer work-order relationship key.
	column 'Work Order Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: da522fd5-fdc1-4cac-9fa1-ac8ad85f8c2f
		summarizeBy: none
		sourceColumn: work_order_key

	/// Work-order relationship key.
	column 'Work Order ID'
		dataType: string
		isAvailableInMdx: false
		lineageTag: 669810a2-babd-4e56-bee9-8ef00d8e3827
		summarizeBy: none
		sourceColumn: work_order_id

		changedProperty = IsHidden

	/// Integer replacement-product relationship key.
	column 'Product Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 1dd8d377-94a2-4171-a7da-59a387830945
