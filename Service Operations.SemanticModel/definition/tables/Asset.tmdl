/// Installed equipment and vehicles owned by customers and serviced by the enterprise.
table Asset
	lineageTag: 1f6d1260-381d-4f66-8bf2-9ea79b6707b2

	/// Number of installed customer assets.
	measure '# Assets' = COUNTROWS(Asset)
		formatString: #,##0
		displayFolder: Measures\Counts
		lineageTag: f2d4f7d5-6dd6-4439-aab2-64cecd02f404

	/// Number of assets classified as operationally critical.
	measure '# Critical Assets' = CALCULATE(COUNTROWS(Asset), KEEPFILTERS(Asset[Criticality] = "Critical"))
		formatString: #,##0
		displayFolder: Measures\Counts
		lineageTag: 0eeee41a-12c9-4ead-bde5-3c08fb911487

	/// Number of assets currently out of service.
	measure '# Assets Out of Service' = CALCULATE(COUNTROWS(Asset), KEEPFILTERS(Asset[Asset Status] = "Out of Service"))
		formatString: #,##0
		displayFolder: Measures\Counts
		lineageTag: ed126dcf-e9d0-45ef-84e2-2dd338aae555

	/// Number of assets by their installation date.
	measure '# Assets Installed' =
			CALCULATE(
			    COUNTROWS(Asset),
			    USERELATIONSHIP(Asset[Install Date Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: f4f86d43-c3a8-4af1-940d-8f0d66e8ec5e

	/// Number of asset warranties by their expiration date.
	measure '# Asset Warranties Expiring' =
			CALCULATE(
			    COUNTROWS(Asset),
			    USERELATIONSHIP(Asset[Warranty Expiry Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: 7b787c7f-6f21-43b8-aa60-a31c5d85357c

	/// Number of asset records by their creation date.
	measure '# Assets Created' =
			CALCULATE(
			    COUNTROWS(Asset),
			    USERELATIONSHIP(Asset[Created On Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: aac27743-1443-46a4-add3-5d17225b50ce

	/// Number of asset records by their most recent modification date.
	measure '# Assets Modified' =
			CALCULATE(
			    COUNTROWS(Asset),
			    USERELATIONSHIP(Asset[Modified On Key], 'Date'[Date Key])
			)
		formatString: #,##0
		displayFolder: Measures\Date Roles
		lineageTag: e6fc204b-f7f2-4df2-a823-d3df1759f605

	/// Integer relationship key optimized for Direct Lake joins.
	column 'Asset Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: dd92dc65-2ea4-4ee2-9791-9d636b4def9b
		summarizeBy: none
		sourceColumn: asset_key

	/// Stable installed-asset identifier.
	column 'Asset ID'
		dataType: string
		lineageTag: 2e0f68e0-1a81-4212-ba19-c174cace76d5
		summarizeBy: none
		sourceColumn: asset_id

		changedProperty = IsHidden

	/// Manufacturer serial number for an installed asset.
	column 'Serial Number'
		dataType: string
		lineageTag: f6166c82-f646-4603-b3ca-f7428a9157ea
		summarizeBy: none
		sourceColumn: serial_number

	/// Integer customer relationship key.
	column 'Customer Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: aecd7a28-60ce-4aed-a87c-428f8c4d3d3a
		summarizeBy: none
		sourceColumn: customer_key

	/// Customer relationship key.
	column 'Customer ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: d0e39d76-0168-413c-8544-cced71f6c91c
		summarizeBy: none
		sourceColumn: customer_id

	/// Integer installed-product relationship key.
	column 'Product Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: ae1ab219-0bff-4d16-85f2-0b0c5947b3e1
		summarizeBy: none
		sourceColumn: product_key

	/// Installed-product relationship key.
	column 'Product ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 6a4f57e7-5990-43d6-a14b-5e95f69abf7a
		summarizeBy: none
		sourceColumn: product_id

	/// Integer servicing-facility relationship key.
	column 'Facility Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 792cc288-8e23-4a44-b70a-0575a8009ead
		summarizeBy: none
		sourceColumn: facility_key

	/// Servicing-facility relationship key.
	column 'Facility ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: d89cef76-28bf-46cb-8109-45666c7759c8
		summarizeBy: none
		sourceColumn: facility_id

	/// Asset specialization used by ontology inheritance.
	column 'Asset Type'
		dataType: string
		lineageTag: 2836afd5-3cbe-47d2-afb1-022aecfedebd
		summarizeBy: none
		sourceColumn: asset_type

	/// Date on which the asset entered service.
	column 'Install Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: e88ba7ca-f09d-480b-ab62-61ef059f895f
		summarizeBy: none
		sourceColumn: install_date

	/// Date on which the standard warranty expires.
	column 'Warranty Expiry'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 1f27dbf9-8e7b-4bc9-a8fe-0e3ee22878ed
		summarizeBy: none
		sourceColumn: warranty_expiry

	/// Operational impact classification.
	column Criticality
		dataType: string
		lineageTag: 0f989e0b-02ca-4d35-bffe-434c7ce608ec
		summarizeBy: none
		sourceColumn: criticality

	/// Current operational status.
	column 'Asset Status'
		dataType: string
		lineageTag: 59185906-a316-43dd-8118-04bf2b2b7716
		summarizeBy: none
		sourceColumn: status

	/// Date on which the asset record was created.
	column 'Created On'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 97f022ce-a689-415f-b9b0-e16dbb1f4c65
		summarizeBy: none
		sourceColumn: created_on

	/// Date on which the asset record was last modified.
	column 'Modified On'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 547a08ea-1bb8-4164-9673-67b679faa3e5
		summarizeBy: none
		sourceColumn: modified_on

	/// Integer date key for asset installation-date analysis.
	column 'Install Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 2d1b2cb1-69a3-461d-a94e-be47aa9cbaa7
		summarizeBy: none
		sourceColumn: install_date_key

	/// Integer date key for warranty-expiry analysis.
	column 'Warranty Expiry Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 9308d695-9743-4d56-9834-37ec4b742727
		summarizeBy: none
		sourceColumn: warranty_expiry_key

	/// Integer date key for asset creation-date analysis.
	column 'Created On Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: d703fe50-1237-44e6-a85f-8cad46508208
		summarizeBy: none
		sourceColumn: created_on_key

	/// Integer date key for asset modification-date analysis.
	column 'Modified On Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 5be2e9fe-515e-4ffc-addc-fd9f16296046
		summarizeBy: none
		sourceColumn: modified_on_key

	partition Asset = entity
		mode: directLake
		source
			entityName: dim_asset
			schemaName: gold
			expressionSource: DirectLakeSource

