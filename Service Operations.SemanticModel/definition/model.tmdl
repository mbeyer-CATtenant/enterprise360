/// Direct Lake service-operations model covering work orders, part consumption, and daily asset status facts with conformed Customer, Product, Part Product, Facility, Technician, Asset, Employee, and Date dimensions sourced from the Enterprise 360 Gold lakehouse.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","TMDLView_Desktop","MCP-PBIModeling"]

ref table Date
ref table Customer
ref table Product
ref table 'Part Product'
ref table Facility
ref table Employee
ref table Technician
ref table Asset
ref table 'Work Orders'
ref table 'Work Order Parts'
ref table 'Asset Daily Status'

